<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Mini Mode: Compact Pill -->
    <LinearLayout
        android:id="@+id/container_mini"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_mini"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_mini_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60.0 FPS"
            android:textColor="@color/green_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#40FFFFFF" />

        <TextView
            android:id="@+id/tv_mini_frametime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16.6 ms"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Expanded Mode: Detailed Performance HUD -->
    <LinearLayout
        android:id="@+id/container_expanded"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_full_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60.0 FPS"
                android:textColor="@color/green_accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_close_floating"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="Close" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_surface_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="Global Surface"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Metrics Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avg FPS"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tv_avg_fps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="59.8"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1% Low"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tv_low1_fps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="54.2"
                    android:textColor="@color/yellow_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="卡顿率"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tv_stutter_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.5%"
                    android:textColor="@color/red_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Real-time Waveform Canvas -->
        <com.fpsmonitor.app.ui.FpsWaveformView
            android:id="@+id/waveform_view"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</FrameLayout>
